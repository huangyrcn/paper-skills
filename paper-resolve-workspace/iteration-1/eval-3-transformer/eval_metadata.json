{
  "eval_id": 3,
  "eval_name": "transformer-title",
  "prompt": "Attention Is All You Need 这篇论文的 metadata 整一下。",
  "assertions": [
    "Calls search_identifiers.py with the title",
    "Output metadata.yaml exists at $PAPERS_DIR/{folder_slug}/metadata.yaml",
    "metadata.yaml contains canonical title",
